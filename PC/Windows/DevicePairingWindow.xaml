<Window x:Class="MyAiAssistant.Windows.DevicePairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备互联 - 仙灵"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceSunkenBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="设备互联（局域网配对）" Foreground="{DynamicResource AccentBrush}"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="局域网服务" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                <TextBlock x:Name="LanStatusText" Text="检测中…" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="配对码" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                <TextBlock x:Name="PairingCodeText" Text="——————" Foreground="{DynamicResource AccentBrush}"
                           FontSize="32" FontWeight="Bold" FontFamily="Consolas"
                           HorizontalAlignment="Center" Margin="0,8"/>
                <TextBlock x:Name="PairingHintText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Text="在手机端 设置 → 设备互联 中输入此配对码完成配对"/>
                <Button x:Name="GenerateButton" Content="生成新配对码" Margin="0,12,0,0"
                        Height="32" Background="{DynamicResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Click="OnGenerateCodeClick"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="已配对设备" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                           Margin="0,0,0,6"/>
                <ListBox Grid.Row="1" x:Name="PairedDevicesList" Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
