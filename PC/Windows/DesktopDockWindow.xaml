<Window x:Class="MyAiAssistant.Windows.DesktopDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="仙灵" Width="6"
        WindowStyle="None" AllowsTransparency="False" Background="#1B1B24"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border BorderBrush="#2C2C3A" BorderThickness="1,0,0,0">
        <DockPanel LastChildFill="False">
            <StackPanel x:Name="BottomHost" DockPanel.Dock="Bottom" Margin="0,0,0,12"/>
            <StackPanel x:Name="DockHost" DockPanel.Dock="Top" Margin="0,12,0,0"/>
        </DockPanel>
    </Border>
</Window>