<Window x:Class="MyAiAssistant.Windows.DesktopDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="仙灵" Width="4"
        WindowStyle="None" AllowsTransparency="False" Background="#000000"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <!--
      纯黑窄条。它常驻在屏幕右缘，所以必须是纯黑：
      深灰在很多壁纸和窗口边框上会显出一道「缝」，纯黑不会。
      收起时只剩 4px，展开 34px —— 比原来收窄，图标也相应缩小。
    -->
    <Border BorderBrush="#1A1A1A" BorderThickness="1,0,0,0">
        <DockPanel LastChildFill="False">
            <StackPanel x:Name="BottomHost" DockPanel.Dock="Bottom" Margin="0,0,0,12"/>
            <StackPanel x:Name="DockHost" DockPanel.Dock="Top" Margin="0,12,0,0"/>
        </DockPanel>
    </Border>
</Window>
