<Window x:Class="MyAiAssistant.Windows.DashboardAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent 控制中心" Width="500" Height="380"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Agent 控制中心" Foreground="#7b68ee"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="#2a2a3e" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="服务地址" Foreground="#aaa" FontSize="12"/>
                <TextBlock x:Name="UrlText" Foreground="#ddd" FontSize="13"
                           FontFamily="Consolas" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#2a2a3e" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="会话令牌" Foreground="#aaa" FontSize="12"/>
                <TextBlock x:Name="TokenText" Foreground="#7b68ee" FontSize="13" Margin="0,4,0,0"
                           FontFamily="Consolas" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="RevealButton" Content="显示令牌" Width="88" Height="28"
                            Background="#3a3a52" Foreground="#ddd" BorderThickness="0"
                            Click="OnRevealClick"/>
                    <Button x:Name="CopyButton" Content="复制令牌" Width="88" Height="28" Margin="8,0,0,0"
                            Background="#3a3a52" Foreground="#ddd" BorderThickness="0"
                            Click="OnCopyClick"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="令牌只保存在本次运行的内存中，用来确认控制操作来自你本人。网页上缺少令牌时，暂停、继续、停止以及同意/拒绝都会被拒绝，这样程序里的 AI 无法自行批准自己的高危操作。关闭应用后令牌失效。"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button x:Name="OpenButton" Content="在浏览器中打开" Width="130" Height="32"
                    Background="#7b68ee" Foreground="White" BorderThickness="0"
                    Click="OnOpenClick"/>
            <Button Content="关闭" Width="80" Height="32" Margin="8,0,0,0"
                    Background="#3a3a52" Foreground="#ddd" BorderThickness="0"
                    Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>