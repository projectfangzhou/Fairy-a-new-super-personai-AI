<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FairyAI_Android.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                  顺序有讲究：
                    1. 主题字典（Theme.*）—— 运行时由 ThemeManager 换掉。
                    2. Semantic.xaml —— 语义别名，用 DynamicResource 指向 Theme.*。
                    3. Styles.xaml —— 控件隐式样式。
                  主题字典必须排在 Semantic 之前：后者靠 DynamicResource 解析前者，
                  顺序反了会让别名解析到上一套主题的值。
                -->
                <ResourceDictionary Source="Resources/Styles/Themes/ThemeMonoDark.xaml" />
                <ResourceDictionary Source="Resources/Styles/Semantic.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Bool converters -->
            <local:InvertBoolConverter x:Key="InvertBool" xmlns:local="clr-namespace:FairyAI_Android"/>

            <!-- Assistant replies are markdown; user messages stay plain text -->
            <local:MarkdownFormattedTextConverter x:Key="MarkdownText" xmlns:local="clr-namespace:FairyAI_Android"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
