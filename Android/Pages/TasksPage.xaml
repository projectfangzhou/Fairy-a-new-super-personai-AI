<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FairyAI_Android.Pages.TasksPage"
             Title="任务与待审批">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource Theme.Bg}" Offset="0.0"/>
            <GradientStop Color="{DynamicResource Theme.BgMid}" Offset="0.5"/>
            <GradientStop Color="{DynamicResource Theme.BgBottom}" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Border BackgroundColor="{DynamicResource Theme.SurfaceCard}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0"
                    Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="来自已配对电脑"
                           TextColor="{DynamicResource Theme.TextPrimary}"
                           FontSize="17"
                           FontAttributes="Bold"/>
                    <Label Text="这里显示电脑上的任务和你需要回答的确认。每次允许或拒绝都会直接作用在电脑上的那一项，电脑端也会同时看到它已被回答。"
                           TextColor="{DynamicResource Theme.TextSecondary}"
                           FontSize="12"/>
                    <Button Text="刷新"
                            BackgroundColor="{DynamicResource Theme.Border}"
                            TextColor="{DynamicResource Theme.TextPrimary}"
                            CornerRadius="12"
                            HeightRequest="42"
                            Clicked="OnRefreshClicked"/>
                    <Label x:Name="StatusLabel"
                           TextColor="{DynamicResource Theme.TextSecondary}"
                           FontSize="12"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="待审批 / 待回答"
                   TextColor="{DynamicResource Theme.TextPrimary}"
                   FontSize="15"
                   FontAttributes="Bold"/>
            <VerticalStackLayout x:Name="PendingList" Spacing="10"/>
            <Label x:Name="PendingEmpty"
                   Text="没有等待你处理的项。"
                   TextColor="{DynamicResource Theme.TextMuted}"
                   FontSize="12"
                   IsVisible="False"/>

            <Label Text="任务"
                   TextColor="{DynamicResource Theme.TextPrimary}"
                   FontSize="15"
                   FontAttributes="Bold"
                   Margin="0,6,0,0"/>
            <VerticalStackLayout x:Name="TaskList" Spacing="6"/>
            <Label x:Name="TasksEmpty"
                   Text="还没有任务。"
                   TextColor="{DynamicResource Theme.TextMuted}"
                   FontSize="12"
                   IsVisible="False"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
