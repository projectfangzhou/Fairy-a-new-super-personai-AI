<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:FairyAI_Android.Pages"
       x:Class="FairyAI_Android.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="#1a1a2e"
       Shell.ForegroundColor="#7b68ee"
       Shell.TabBarBackgroundColor="#1a1a2e"
       Shell.TabBarForegroundColor="#9d8bff"
       Shell.TabBarTitleColor="#9d8bff"
       Shell.TabBarUnselectedColor="#8A8FA3">

    <!-- Chat first: it is the product. Everything else is reached from the dashboard. -->
    <TabBar>
        <ShellContent x:Name="ChatTab"
                      Title="对话"
                      Icon="{OnPlatform iOS='chat_bubble'}"/>
        <ShellContent x:Name="DashboardTab"
                      Title="看板"
                      Route="dashboard"/>
        <ShellContent x:Name="TasksTab"
                      Title="任务"
                      Route="tasks"
                      Icon="{OnPlatform iOS='list_bullet'}"/>
        <ShellContent x:Name="SettingsTab"
                      Title="设置"
                      Route="settings"
                      Icon="{OnPlatform iOS='settings'}"/>
    </TabBar>

</Shell>
